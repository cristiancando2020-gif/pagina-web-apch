---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Institución | Unidad Educativa Ángel Polibio Chaves">

    <Navbar />

    <main>

        <!-- ENCABEZADO -->
        <section class="pagina-encabezado">
            <div class="container text-center">

                <span class="subtitulo-seccion">
                    Nuestra institución
                </span>
                <h1>
                    Historia e Información Institucional
                </h1>

                <p>
                    Conoce la trayectoria de la Unidad Educativa
                    Ángel Polibio Chaves y los principales datos
                    que identifican a nuestra institución.
                </p>

            </div>
        </section>


        <!-- HISTORIA -->
        <section class="historia-completa">

            <div class="container py-5">

                <div class="row align-items-center g-5 mb-5">

                    <div class="col-lg-6">

                        <img
                            src="/Images/Institucion/Historia-apch.jpg"
                            alt="Unidad Educativa Ángel Polibio Chaves"
                            class="img-fluid rounded-4 shadow historia-imagen"
                        />

                    </div>

                    <div class="col-lg-6">

                        <span class="subtitulo-seccion">
                            Nuestra historia
                        </span>

                        <h2 class="titulo-seccion">
                            Una trayectoria educativa desde 1938
                        </h2>

                        <p>
                            La historia de la actual Unidad Educativa
                            Ángel Polibio Chaves se remonta al
                            22 de diciembre de 1938, fecha en la que
                            se firmó el Decreto de Creación del
                            Normal Rural de San Miguel, con el número 032.
                        </p>

                        <p>
                            La creación fue impulsada durante la gestión
                            del Ministro de Educación Pública José María
                            Estrada Cuello y contó con el apoyo de
                            autoridades y representantes del cantón
                            San Miguel.
                        </p>

                    </div>

                </div>


                <!-- LÍNEA DE TIEMPO -->
                <div class="linea-tiempo">

                    <!-- 1938 -->
                    <div class="evento-historia">

                        <div class="anio-historia">
                            1938
                        </div>

                        <div class="contenido-historia">

                            <h3>
                                Creación del Normal Rural
                            </h3>

                            <p>
                                El 22 de diciembre de 1938 se firma
                                el Decreto de Creación del Normal Rural
                                de San Miguel, identificado con el
                                número 032.
                            </p>

                            <p>
                                Entre los gestores de su creación se
                                encontraban el Visitador de Educación
                                Filemón Gracia Reina, el Dr. César Augusto
                                Durango y representantes del Ilustre
                                Consejo Cantonal de la época.
                            </p>

                        </div>

                    </div>


                    <!-- 1939 -->
                    <div class="evento-historia">

                        <div class="anio-historia">
                            1939
                        </div>

                        <div class="contenido-historia">

                            <h3>
                                Inicio de las actividades educativas
                            </h3>

                            <p>
                                En marzo de 1939 se integra el personal
                                docente del establecimiento. Alfredo León
                                Velasco fue designado como primer Director
                                del Plantel.
                            </p>

                            <p>
                                La institución fue inaugurada el
                                4 de mayo de 1939. Las matrículas se
                                abrieron en octubre del mismo año con
                                45 estudiantes entre hombres y mujeres.
                            </p>

                            <p>
                                Durante sus primeros meses funcionó en
                                el edificio del Concejo Municipal.
                                Posteriormente se realizó la adquisición
                                de la quinta Poroto Pamba.
                            </p>

                        </div>

                    </div>


                    <!-- 1943 -->
                    <div class="evento-historia">

                        <div class="anio-historia">
                            1943
                        </div>

                        <div class="contenido-historia">

                            <h3>
                                Adopción del nombre Ángel Polibio Chaves
                            </h3>

                            <p>
                                La Junta General de Profesores del
                                Normal Rural acordó otorgar a la
                                institución el nombre
                                “Ángel Polibio Chaves”, consolidando
                                una identidad que continúa hasta la
                                actualidad.
                            </p>

                        </div>

                    </div>


                    <!-- 1975 -->
                    <div class="evento-historia">

                        <div class="anio-historia">
                            1975
                        </div>

                        <div class="contenido-historia">

                            <h3>
                                Colegio Nacional Ángel Polibio Chaves
                            </h3>

                            <p>
                                Desde 1975 la institución funcionó como
                                Colegio Nacional Ángel Polibio Chaves,
                                ampliando progresivamente su oferta
                                académica.
                            </p>

                            <p>
                                A lo largo de esta etapa se ofrecieron
                                bachilleratos en Humanidades Modernas,
                                Ciencias y diferentes especialidades
                                técnicas relacionadas con informática,
                                comercio, administración, turismo y
                                contabilidad.
                            </p>

                        </div>

                    </div>


                    <!-- 2013 -->
                    <div class="evento-historia">

                        <div class="anio-historia">
                            2013
                        </div>

                        <div class="contenido-historia">

                            <h3>
                                Nueva etapa institucional
                            </h3>

                            <p>
                                El 17 de julio de 2013, mediante
                                Resolución 00578, la institución se
                                fusionó con la Unidad Educativa del
                                Milenio Rodrigo Riofrío Jiménez.
                            </p>

                            <p>
                                A partir de este proceso pasó a
                                denominarse Unidad Educativa del Milenio
                                Ángel Polibio Chaves.
                            </p>

                        </div>

                    </div>


                    <!-- ACTUALIDAD -->
                    <div class="evento-historia">

                        <div class="anio-historia actualidad">
                            Hoy
                        </div>

                        <div class="contenido-historia">

                            <h3>
                                La institución en la actualidad
                            </h3>

                            <p>
                                Actualmente la institución continúa
                                desarrollando su labor educativa en el
                                cantón San Miguel de Bolívar, con
                                Educación Inicial, Educación General
                                Básica, Bachillerato en Ciencias y
                                Bachillerato Técnico en Informática.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- INFORMACIÓN INSTITUCIONAL -->
        <section class="datos-generales-institucion">

            <div class="container py-5">

                <div class="text-center encabezado-seccion">

                    <span class="subtitulo-seccion">
                        Datos generales
                    </span>

                    <h2 class="titulo-seccion">
                        Información Institucional
                    </h2>

                    <p class="descripcion-seccion">
                        Principales datos administrativos y académicos
                        de la Unidad Educativa Ángel Polibio Chaves.
                    </p>

                </div>

                <div class="row g-4 mt-4">


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                🏫
                            </span>

                            <div>
                                <strong>Código AMIE</strong>
                                <p>02H00499</p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                📍
                            </span>

                            <div>
                                <strong>Dirección</strong>
                                <p>
                                    Av. El Maestro y Augusto Zavala,
                                    Barrio 13 de Abril
                                </p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                🗺️
                            </span>

                            <div>
                                <strong>Distrito</strong>
                                <p>02D03 Chimbo - San Miguel</p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                🏛️
                            </span>

                            <div>
                                <strong>Sostenimiento</strong>
                                <p>Fiscal</p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                📚
                            </span>

                            <div>
                                <strong>Régimen</strong>
                                <p>Sierra / Amazonía</p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                🧑‍🏫
                            </span>

                            <div>
                                <strong>Modalidad</strong>
                                <p>Presencial</p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                ☀️
                            </span>

                            <div>
                                <strong>Jornada</strong>
                                <p>Matutina</p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                📄
                            </span>

                            <div>
                                <strong>
                                    Resolución de funcionamiento
                                </strong>

                                <p>
                                    MINEDUC-CZ5-2023-00217-R
                                </p>
                            </div>

                        </div>
                    </div>


                    <div class="col-md-6 col-lg-4">
                        <div class="dato-general">

                            <span class="dato-general-icono">
                                🎓
                            </span>

                            <div>
                                <strong>
                                    Niveles educativos
                                </strong>

                                <p>
                                    Inicial, EGB y Bachillerato
                                </p>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </section>



    </main>

</Layout>
