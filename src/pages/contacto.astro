---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contacto from '../components/Contacto.astro';
---

<Layout title="Contacto | Unidad Educativa Ángel Polibio Chaves">

    <Navbar />

    <main>

        <section class="pagina-encabezado">

            <div class="container text-center">

                <span class="subtitulo-seccion">
                    Información institucional
                </span>

                <h1>
                    Contacto
                </h1>

                <p>
                    Comunícate con la Unidad Educativa
                    Ángel Polibio Chaves o encuentra nuestra ubicación.
                </p>

            </div>

        </section>


        <Contacto />

    </main>

</Layout>