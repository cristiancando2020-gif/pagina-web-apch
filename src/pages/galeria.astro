---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Galeria from '../components/Galeria.astro';
---

<Layout title="Galería | Unidad Educativa Ángel Polibio Chaves">

    <Navbar />

    <main>

        <section class="pagina-encabezado">

            <div class="container text-center">

                <span class="subtitulo-seccion">
                    Nuestra comunidad
                </span>

                <h1>
                    Galería
                </h1>

                <p>
                    Imágenes de nuestra institución,
                    actividades y comunidad educativa.
                </p>

            </div>

        </section>


        <Galeria />

    </main>

</Layout>