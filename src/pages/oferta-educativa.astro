---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Oferta Educativa | Unidad Educativa Ángel Polibio Chaves">

    <Navbar />

    <main>

        <section class="pagina-encabezado">
            <div class="container text-center">

                <span class="subtitulo-seccion">
                    Formación académica
                </span>

                <h1>
                    Oferta Educativa
                </h1>

                <p>
                    Conoce los niveles y modalidades educativas que ofrece
                    la Unidad Educativa Ángel Polibio Chaves.
                </p>

            </div>
        </section>

        <section class="oferta-detalle">

            <div class="container py-5">

                <div class="row g-4">

                    <!-- EDUCACIÓN INICIAL -->
                    <div class="col-md-6">

                        <article class="tarjeta-oferta-detalle">

                            <div class="imagen-oferta">
                                <img
                                    src="/Images/OfertaAcademica/Inicial.png"
                                    alt="Educación Inicial"
                                />
                            </div>

                            <h3>
                                Educación Inicial
                            </h3>

                            <p>
                                La institución ofrece Educación Inicial para niñas y niños
                                de 3 y 4 años, promoviendo su desarrollo integral mediante
                                experiencias educativas acordes a su edad.
                            </p>

                            <div class="detalle-oferta">
                                <strong>Niveles:</strong>
                                Grupo de 3 años y Grupo de 4 años.
                            </div>

                        </article>

                    </div>

                    <!-- EGB -->
                    <div class="col-lg-6">

                        <article class="tarjeta-oferta-detalle">

                            <div class="imagen-oferta">
                                <img
                                    src="/Images/OfertaAcademica/Basica.png"
                                    alt="Educación General Básica"
                                />
                            </div>

                            <h2>
                                Educación General Básica
                            </h2>

                            <p>
                                Formación académica orientada al desarrollo
                                de conocimientos, habilidades, valores y
                                competencias durante las diferentes etapas
                                de la educación básica.
                            </p>

                            <div class="nivel-detalle">
                                <strong>Comprende:</strong>
                                Preparatoria, Básica Elemental,
                                Básica Media y Básica Superior.
                            </div>

                        </article>

                    </div>

                    <!-- CIENCIAS -->
                    <div class="col-lg-6">

                        <article class="tarjeta-oferta-detalle">

                            <div class="imagen-oferta">
                                <img
                                    src="/Images/OfertaAcademica/BachilleratoCiencias.png"
                                    alt="Bachillerato en Ciencias"
                                />
                            </div>

                            <h2>
                                Bachillerato en Ciencias
                            </h2>

                            <p>
                                Formación integral orientada al desarrollo
                                del pensamiento crítico, científico y
                                académico, preparando a los estudiantes
                                para continuar sus estudios superiores.
                            </p>

                            <div class="nivel-detalle">
                                <strong>Cursos:</strong>
                                Primero, Segundo y Tercero de Bachillerato.
                            </div>

                        </article>

                    </div>

                    <!-- INFORMÁTICA -->
                    <div class="col-lg-6">

                        <article class="tarjeta-oferta-detalle">

                            <div class="imagen-oferta">
                                <img
                                    src="/Images/OfertaAcademica/Informatica.png"
                                    alt="Bachillerato Técnico en Informática"
                                />
                            </div>

                            <h2>
                                Bachillerato Técnico en Informática
                            </h2>

                            <p>
                                Formación tecnológica enfocada en el
                                desarrollo de competencias digitales,
                                técnicas y prácticas relacionadas con
                                las tecnologías de la información.
                            </p>

                            <div class="nivel-detalle">
                                <strong>Área:</strong>
                                TICs - Figura Profesional en Informática. <br>
                                <strong>Cursos:</strong>
                                Primero, Segundo y Tercero de Bachillerato.
                            </div>

                        </article>

                    </div>

                    <!-- TELECOMUNICACIONES Y REDES -->
                    <div class="col-md-8 col-lg-6 mx-auto">

                       <article class="tarjeta-oferta-detalle">

                           <div class="imagen-oferta">
                              <img
                                 src="/Images/OfertaAcademica/Telecomunicaciones.png"
                                 alt="Bachillerato Técnico en Telecomunicaciones y Redes"
                              />
                          </div>

                          <h3 class="titulo-oferta">
                                   Bachillerato Técnico en Telecomunicaciones y Redes
                          </h3>

                          <p>
                                Formación técnica enfocada en redes, conectividad,
                                telecomunicaciones y mantenimiento de sistemas de comunicación.
                         </p>

                         <div class="detalle-oferta">
                                <strong>Área:</strong>
                                 Telecomunicaciones y Redes.

                                <br />
                                
                                <strong>Cursos:</strong>
                                Primero, Segundo y Tercero de Bachillerato.

                         </div>

                     </article>

                    </div>

                </div>

            </div>

        </section>

    </main>

</Layout>