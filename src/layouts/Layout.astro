---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Unidad Educativa Ángel Polibio Chaves',
    description = 'Sitio web institucional de la Unidad Educativa Ángel Polibio Chaves de San Miguel de Bolívar'
} = Astro.props;
---

<!doctype html>
<html lang="es">

<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>
</head>

<body>

    <slot />
    <Footer />

    <script>
        import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>

</body>

</html>