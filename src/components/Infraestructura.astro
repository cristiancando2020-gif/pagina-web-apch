---
import { withBase } from '../utils/paths';
---

<section class="infraestructura-seccion">

    <div class="container py-5">

        <div class="text-center encabezado-seccion">

            <span class="subtitulo-seccion">
                Nuestros espacios
            </span>

            <h2 class="titulo-seccion">
                Infraestructura Institucional
            </h2>

            <p class="descripcion-seccion">
                Espacios diseñados para apoyar la formación académica,
                tecnológica, cultural y deportiva de nuestros estudiantes.
            </p>

        </div>

        <div class="row g-4 mt-4">

            <!-- AULAS -->
            <div class="col-md-6 col-lg-4 d-flex">

                <article class="tarjeta-infraestructura w-100">

                    <div class="infraestructura-imagen">
                        <img
                            src={withBase('/Images/Infraestructura/Aulas.jpg')}
                            alt="Aulas de la institución"
                        />
                    </div>

                    <div class="infraestructura-contenido">
                        <h3>65 Aulas</h3>

                        <p>
                            Espacios destinados al desarrollo de las
                            actividades académicas de los diferentes
                            niveles educativos.
                        </p>
                    </div>

                </article>

            </div>


            <!-- LABORATORIOS -->
            <div class="col-md-6 col-lg-4 d-flex">

                <article class="tarjeta-infraestructura w-100">

                    <div class="infraestructura-imagen">
                        <img
                            src={withBase('/Images/Infraestructura/Laboratorios.jpg')}
                            alt="Laboratorios de la institución"
                        />
                    </div>

                    <div class="infraestructura-contenido">
                        <h3>6 Laboratorios</h3>

                        <p>
                            Espacios destinados al aprendizaje práctico,
                            científico y tecnológico.
                        </p>
                    </div>

                </article>

            </div>


            <!-- PATIOS -->
            <div class="col-md-6 col-lg-4 d-flex">

                <article class="tarjeta-infraestructura w-100">

                    <div class="infraestructura-imagen">
                        <img
                            src={withBase('/Images/Infraestructura/Patios.jpg')}
                            alt="Patios de la institución"
                        />
                    </div>

                    <div class="infraestructura-contenido">
                        <h3>7 Patios</h3>

                        <p>
                            Espacios para actividades recreativas,
                            culturales y de convivencia estudiantil.
                        </p>
                    </div>

                </article>

            </div>


            <!-- SALÓN DE ACTOS -->
            <div class="col-md-6 col-lg-4 d-flex">

                <article class="tarjeta-infraestructura w-100">

                    <div class="infraestructura-imagen">
                        <img
                            src={withBase('/Images/Infraestructura/Salon-actos.jpg')}
                            alt="Salón de actos"
                        />
                    </div>

                    <div class="infraestructura-contenido">
                        <h3>Salón de Actos</h3>

                        <p>
                            Espacio destinado a eventos académicos,
                            culturales y actividades institucionales.
                        </p>
                    </div>

                </article>

            </div>


            <!-- AUDIOVISUALES -->
            <div class="col-md-6 col-lg-4 d-flex">

                <article class="tarjeta-infraestructura w-100">

                    <div class="infraestructura-imagen">
                        <img
                            src={withBase('/Images/Infraestructura/Audiovisuales.jpg')}
                            alt="Sala de audiovisuales"
                        />
                    </div>

                    <div class="infraestructura-contenido">
                        <h3>Sala de Audiovisuales</h3>

                        <p>
                            Espacio equipado para apoyar actividades
                            educativas mediante recursos audiovisuales.
                        </p>
                    </div>

                </article>

            </div>


            <!-- ÁREAS DEPORTIVAS -->
            <div class="col-md-6 col-lg-4 d-flex">

                <article class="tarjeta-infraestructura w-100">

                    <div class="infraestructura-imagen">
                        <img
                            src={withBase('/Images/Infraestructura/Areas-deportivas.jpg')}
                            alt="Áreas deportivas"
                        />
                    </div>

                    <div class="infraestructura-contenido">
                        <h3>Áreas Deportivas</h3>

                        <p>
                            Espacios destinados al deporte,
                            recreación y desarrollo físico estudiantil.
                        </p>
                    </div>

                </article>

            </div>

        </div>

    </div>

</section>