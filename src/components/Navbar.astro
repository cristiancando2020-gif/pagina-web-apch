---
import { withBase } from '../utils/paths';
---

<nav class="navbar navbar-expand-lg navbar-dark navbar-apch sticky-top">

    <div class="container">

        <!-- Logo y nombre -->
        <a class="navbar-brand d-flex align-items-center" href={withBase('/')}>

            <div class="logo-marco">
                <img
                   src={withBase('/Images/Logo/Logo-apch.png')}
                   alt="Escudo de la Unidad Educativa Ángel Polibio Chaves"
                   class="logo-navbar"
                />
            </div>


            <div class="nombre-institucion ms-3">
                <strong>Unidad Educativa</strong>
                <span>Ángel Polibio Chaves</span>
            </div>

        </a>

        <!-- Botón para celular -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuPrincipal"
            aria-controls="menuPrincipal"
            aria-expanded="false"
            aria-label="Abrir menú"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Opciones -->
        <div
            class="collapse navbar-collapse"
            id="menuPrincipal"
        >

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/')}>
                        Inicio
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/institucion')}>
                        Institución
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/oferta-educativa')}>
                        Oferta Educativa
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/horarios')}>
                        Horarios
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/infraestructura')}>
                        Infraestructura
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/galeria')}>
                        Galería
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href={withBase('/contacto')}>
                        Contacto
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>