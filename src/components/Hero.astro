<section class="hero-carousel">

    <div
        id="carouselAPCH"
        class="carousel slide carousel-fade"
        data-bs-ride="carousel"
        data-bs-interval="5000"
    >

        <!-- INDICADORES -->
        <div class="carousel-indicators">

            <button
                type="button"
                data-bs-target="#carouselAPCH"
                data-bs-slide-to="0"
                class="active"
                aria-current="true"
                aria-label="Evento 1"
            ></button>

            <button
                type="button"
                data-bs-target="#carouselAPCH"
                data-bs-slide-to="1"
                aria-label="Evento 2"
            ></button>

            <button
                type="button"
                data-bs-target="#carouselAPCH"
                data-bs-slide-to="2"
                aria-label="Evento 3"
            ></button>

            <button
                type="button"
                data-bs-target="#carouselAPCH"
                data-bs-slide-to="3"
                aria-label="Evento 4"
            ></button>

        </div>


        <!-- CONTENIDO DEL CARRUSEL -->
        <div class="carousel-inner">


            <!-- =========================
                 EVENTO 1
            ========================== -->

            <div class="carousel-item active">

                <img
                    src="/Images/Slider/Slider-1.jpg"
                    class="d-block w-100 carousel-imagen"
                    alt="Unidad Educativa Ángel Polibio Chaves"
                />

                <div class="carousel-filtro"></div>


                <div class="carousel-caption-apch">

                    <div class="container">

                        <div class="contenido-evento">

                            <span class="evento-etiqueta">
                                Nuestra institución
                            </span>

                            <h1>
                                Ángel Polibio Chaves
                            </h1>

                            <p>
                                Educación integral, innovación pedagógica,
                                inclusión y formación para el futuro.
                            </p>

                            <a
                                href="/institucion"
                                class="btn btn-evento"
                            >
                                Conoce nuestra institución
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================
                 EVENTO 2
            ========================== -->

            <div class="carousel-item">

                <img
                    src="/Images/Slider/Slider-2.jpg"
                    class="d-block w-100 carousel-imagen"
                    alt="Actividades académicas"
                />

                <div class="carousel-filtro"></div>


                <div class="carousel-caption-apch">

                    <div class="container">

                        <div class="contenido-evento">

                            <span class="evento-etiqueta">
                                Actividades académicas
                            </span>

                            <h2>
                                Aprendemos creando
                            </h2>

                            <p>
                                Ferias, exposiciones y proyectos permiten
                                fortalecer los conocimientos y habilidades
                                de nuestros estudiantes.
                            </p>

                            <a
                                href="/galeria"
                                class="btn btn-evento"
                            >
                                Ver actividades
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================
                 EVENTO 3
            ========================== -->

            <div class="carousel-item">

                <img
                    src="/Images/Slider/Slider-3.jpg"
                    class="d-block w-100 carousel-imagen"
                    alt="Actividades culturales"
                />

                <div class="carousel-filtro"></div>


                <div class="carousel-caption-apch">

                    <div class="container">

                        <div class="contenido-evento">

                            <span class="evento-etiqueta">
                                Cultura y comunidad
                            </span>

                            <h2>
                                Vivimos nuestras tradiciones
                            </h2>

                            <p>
                                Promovemos actividades culturales y artísticas
                                que fortalecen la identidad y participación
                                de nuestra comunidad educativa.
                            </p>

                            <a
                                href="/galeria"
                                class="btn btn-evento"
                            >
                                Conoce nuestros eventos
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================
                 EVENTO 4
            ========================== -->

            <div class="carousel-item">

                <img
                    src="/Images/Slider/Slider-4.jpg"
                    class="d-block w-100 carousel-imagen"
                    alt="Actividades deportivas"
                />

                <div class="carousel-filtro"></div>


                <div class="carousel-caption-apch">

                    <div class="container">

                        <div class="contenido-evento">

                            <span class="evento-etiqueta">
                                Deporte y bienestar
                            </span>

                            <h2>
                                Crecemos también a través del deporte
                            </h2>

                            <p>
                                Incentivamos la participación, el compañerismo
                                y los hábitos saludables mediante diferentes
                                actividades deportivas.
                            </p>

                            <a
                                href="/galeria"
                                class="btn btn-evento"
                            >
                                Ver galería
                            </a>

                        </div>

                    </div>

                </div>

            </div>


        </div>


        <!-- FLECHA ANTERIOR -->

        <button
            class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselAPCH"
            data-bs-slide="prev"
        >

            <span
                class="carousel-control-prev-icon"
                aria-hidden="true"
            ></span>

            <span class="visually-hidden">
                Anterior
            </span>

        </button>


        <!-- FLECHA SIGUIENTE -->

        <button
            class="carousel-control-next"
            type="button"
            data-bs-target="#carouselAPCH"
            data-bs-slide="next"
        >

            <span
                class="carousel-control-next-icon"
                aria-hidden="true"
            ></span>

            <span class="visually-hidden">
                Siguiente
            </span>

        </button>


    </div>

</section>