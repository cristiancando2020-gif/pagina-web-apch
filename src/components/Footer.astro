---
import { withBase } from '../utils/paths';

const currentYear = new Date().getFullYear();
---

<footer class="footer-apch">

    <div class="container">

        <div class="row g-5">

            <!-- INSTITUCIÓN -->
            <div class="col-lg-4 col-md-6">

                <div class="footer-institucion">

                    <img
                        src={withBase('/Images/Logo/Logo-apch.png')}
                        alt="Logo Unidad Educativa Ángel Polibio Chaves"
                        class="footer-logo"
                    />

                    <div>
                        <h2>
                            Unidad Educativa
                        </h2>

                        <h3>
                            Ángel Polibio Chaves
                        </h3>
                    </div>

                </div>

                <p class="footer-descripcion">
                    Institución educativa comprometida con una
                    formación integral, inclusiva, científica,
                    tecnológica y humanística.
                </p>

            </div>


            <!-- ENLACES -->
            <div class="col-lg-2 col-md-6">

                <h4 class="footer-titulo">
                    Enlaces
                </h4>

                <ul class="footer-links">

                    <li>
                        <a href={withBase('/')}>
                            Inicio
                        </a>
                    </li>

                    <li>
                        <a href={withBase('/institucion')}>
                            Institución
                        </a>
                    </li>

                    <li>
                        <a href={withBase('/oferta-educativa')}>
                            Oferta Educativa
                        </a>
                    </li>

                    <li>
                        <a href={withBase('/infraestructura')}>
                            Infraestructura
                        </a>
                    </li>

                    <li>
                        <a href={withBase('/galeria')}>
                            Galería
                        </a>
                    </li>

                </ul>

            </div>


            <!-- INFORMACIÓN -->
            <div class="col-lg-3 col-md-6">

                <h4 class="footer-titulo">
                    Información académica
                </h4>

                <ul class="footer-links">

                    <li>
                        <a href={withBase('/horarios')}>
                            Horarios
                        </a>
                    </li>

                    <li>
                        <a href={withBase('/contacto')}>
                            Contacto
                        </a>
                    </li>

                    <li>
                        <a href={withBase('/oferta-educativa')}>
                            Niveles Educativos
                        </a>
                    </li>

                </ul>

            </div>


            <!-- CONTACTO -->
            <div class="col-lg-3 col-md-6">

                <h4 class="footer-titulo">
                    Contacto
                </h4>

                <div class="footer-contacto">

                    <p>
                        <span>📍</span>

                        Av. El Maestro y Augusto Zavala,
                        San Miguel de Bolívar
                    </p>


                    <p>
                        <span>📞</span>

                        <a href="tel:032989035">
                            032989035
                        </a>
                    </p>


                    <p>
                        <span>✉️</span>

                        <a href="mailto:colegio_apch_sm@yahoo.es">
                            colegio_apch_sm@yahoo.es
                        </a>
                    </p>


                    <p>
                        <span>📘</span>

                        <a
                            href="https://facebook.com/UnidadEducativaAPCH"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Facebook
                        </a>
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- PARTE INFERIOR -->
    <div class="footer-inferior">

        <div class="container">

            <div class="footer-inferior-contenido">

                <p>
                    © {currentYear} Unidad Educativa Ángel Polibio Chaves.
                    Todos los derechos reservados.
                </p>

                <p>
                    San Miguel de Bolívar - Ecuador
                </p>

            </div>

        </div>

    </div>

</footer>