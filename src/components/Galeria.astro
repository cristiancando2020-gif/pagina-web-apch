---
import { withBase } from '../utils/paths';
---

<section class="galeria-seccion">

    <div class="container py-5">

        <div class="text-center encabezado-seccion">

            <span class="subtitulo-seccion">
                Nuestra comunidad
            </span>

            <h2 class="titulo-seccion">
                Galería Institucional
            </h2>

            <p class="descripcion-seccion">
                Conoce algunos de nuestros espacios, actividades
                académicas, culturales y eventos institucionales.
            </p>

        </div>


        <div class="row g-4 mt-4">


            <!-- IMAGEN 1 -->
            <div class="col-md-6 col-lg-4">

                <a
                    href={withBase('/Images/Galeria/Institucion-1.jpg')}
                    target="_blank"
                    class="galeria-item"
                >

                    <img
                        src={withBase('/Images/Galeria/Institucion-1.jpg')}
                        alt="Instalaciones de la Unidad Educativa Ángel Polibio Chaves"
                    />

                    <div class="galeria-overlay">

                        <div>
                            <h3>
                                Nuestra Institución
                            </h3>

                            <span>
                                Ver fotografía
                            </span>
                        </div>

                    </div>

                </a>

            </div>


            <!-- IMAGEN 2 -->
            <div class="col-md-6 col-lg-4">

                <a
                    href={withBase('/Images/Galeria/Institucion-2.jpg')}
