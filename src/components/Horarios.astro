---
import { withBase } from '../utils/paths';
---

<section class="horarios-seccion">

    <div class="container py-5">

        <div class="text-center encabezado-seccion">

            <span class="subtitulo-seccion">
                Periodo lectivo 2026 - 2027
            </span>

            <h2 class="titulo-seccion">
                Horarios de Bachillerato
            </h2>

            <p class="descripcion-seccion">
                Consulta los horarios académicos correspondientes
                a los cursos de Bachillerato en Ciencias y
                Bachillerato Técnico.
            </p>

        </div>


        <!-- INFORMACIÓN GENERAL -->
        <div class="horario-info mt-5">

            <div class="row text-center g-3">

                <div class="col-md-4">

                    <div class="horario-dato">

                        <span class="horario-icono">
                            🕐
                        </span>

                        <div>
                            <strong>Inicio de jornada</strong>
                            <p>07:15</p>
                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="horario-dato">

                        <span class="horario-icono">
                            ☕
                        </span>

                        <div>
                            <strong>Recreo</strong>
                            <p>10:15 - 10:45</p>
                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="horario-dato">

                        <span class="horario-icono">
                            🕜
                        </span>

                        <div>
                            <strong>Fin de jornada</strong>
                            <p>13:45</p>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CURSOS -->
        <div class="mt-5">

            <h3 class="horarios-subtitulo">
                Cursos disponibles
            </h3>


            <!-- PRIMERO -->
            <div class="grupo-horarios">

                <h4>
                    Primero de Bachillerato
                </h4>

                <div class="lista-cursos">

                    <span>BGU A</span>
                    <span>BGU B</span>
                    <span>BGU C</span>
                    <span>BGU D</span>
                    <span>BGU E</span>
                    <span>BT F</span>

                </div>

            </div>


            <!-- SEGUNDO -->
            <div class="grupo-horarios">

                <h4>
                    Segundo de Bachillerato
                </h4>

                <div class="lista-cursos">

                    <span>BGU A</span>
                    <span>BGU B</span>
                    <span>BGU C</span>
                    <span>BGU D</span>
                    <span>BGU E</span>
                    <span>BT F</span>

                </div>

            </div>


            <!-- TERCERO -->
            <div class="grupo-horarios">

                <h4>
                    Tercero de Bachillerato
                </h4>

                <div class="lista-cursos">

                    <span>BGU A</span>
                    <span>BGU B</span>
                    <span>BGU C</span>
                    <span>BGU D</span>
                    <span>BGU E</span>
                    <span>BT F</span>

                </div>

            </div>

        </div>


        <!-- VISOR DEL PDF -->
        <div class="visor-horarios mt-5">

            <div class="visor-encabezado">

                <div>

                    <span class="subtitulo-seccion">
                        Documento oficial
                    </span>

                    <h3>
                        Horarios Bachillerato 2026 - 2027
                    </h3>

                </div>


                <a
                    href={withBase('/Documents/Horarios-Bachillerato-2026-2027.pdf')}
                    target="_blank"
                    class="btn btn-apch"
                >
                    Abrir PDF
                </a>

            </div>


            <div class="pdf-contenedor">

                <iframe
                    src={withBase('/Documents/Horarios-Bachillerato-2026-2027.pdf')}
                    title="Horarios de Bachillerato 2026-2027"
                >
                </iframe>

            </div>

        </div>

    </div>

</section>