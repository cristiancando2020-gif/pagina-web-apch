---
import { withBase } from '../utils/paths';
---

<section class="oferta-educativa">

    <div class="container py-5">

        <div class="text-center encabezado-seccion">

            <span class="subtitulo-seccion">
                Formación académica
            </span>

            <h2 class="titulo-seccion">
                Nuestra Oferta Educativa
            </h2>

            <p class="descripcion-seccion">
                Acompañamos a nuestros estudiantes durante las
                diferentes etapas de su formación académica.
            </p>

        </div>

        <div class="row g-4 mt-4">

            <!-- INICIAL -->
            <div class="col-md-6 col-lg-3">

                <article class="tarjeta-oferta">

                    <h3>
                        Educación Inicial
                    </h3>

                    <p>
                        Educación dirigida a niñas y niños de 3 y 4 años,
                        orientada a fortalecer su desarrollo integral.
                    </p>

                </article>

            </div>

            <!-- EGB -->
            <div class="col-md-6 col-lg-3">

                <article class="tarjeta-oferta">

                    <h3>
                        Educación General Básica
                    </h3>

                    <p>
                        Comprende desde preparatoria hasta básica superior,
                        fortaleciendo conocimientos, habilidades y valores.
                    </p>

                </article>

            </div>

            <!-- BACHILLERATO EN CIENCIAS -->
            <div class="col-md-6 col-lg-3">

                <article class="tarjeta-oferta">

                    <h3>
                        Bachillerato en Ciencias
                    </h3>

                    <p>
                        Formación académica para continuar estudios
                        superiores y desarrollar pensamiento crítico.
                    </p>

                </article>

            </div>

            <!-- TÉCNICO -->
            <div class="col-md-6 col-lg-3">

                <article class="tarjeta-oferta">

                    <h3>
                        Bachillerato Técnico en Informática
                    </h3>
                    <h3>
                        Bachillerato en Telecomunicación y Redes 
                    </h3>

                    <p>
                        Formación tecnológica orientada al desarrollo
                        de competencias digitales, técnicas y prácticas.
                    </p>

                    <p> 
                        Formación técnica orientada al desarrollo de competencias
                        en instalación, configuración, mantenimiento y administración 
                        básica de redes y sistemas de telecomunicaciones.
                    </p>

                </article>

            </div>

        </div>

        <div class="text-center mt-5">

            <a
                href={withBase('/oferta-educativa')}
                class="btn btn-apch"
            >
                Conoce nuestra oferta educativa
            </a>

        </div>

    </div>

</section>